# ---- LLM -------------------------------------------------------------------
# The pipeline runs WITHOUT any key (deterministic heuristic fallback is used and
# every audit event records which engine produced the object). Add a key to get
# real structured LLM extraction / explanations / negotiation copy.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Internet research (Linkup) --------------------------------------------
LINKUP_API_KEY=
LINKUP_DEFAULT_DEPTH=standard   # fast | standard | deep
LINKUP_MAX_CALLS_PER_RUN=20
LINKUP_TIMEOUT_SECONDS=45

# ---- Demo defaults ---------------------------------------------------------
SYE_MODE=demo
SYE_OFFLINE=true
SYE_SEED=42
SYE_MARKET=SE
SYE_CURRENCY=EUR
SYE_DATA_DIR=data
# Offline catalogue location (defaults to <project>/data/fixtures)
# SYE_FIXTURES_DIR=data/fixtures
SYE_DB_URL=sqlite:///data/sye.db

# ---- API -------------------------------------------------------------------
SYE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Optional tracing (never required by the demo) -------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sye-demand-aggregation
